GET     /livez                   public
GET     /readyz                  public
GET     /startupz                public
GET     /swagger/*               public
GET     /v1/config               requires-auth
GET     /v1/containers           requires-auth
GET     /v1/containers/details   requires-auth
GET     /v1/events               requires-auth
GET     /v1/history              requires-auth
GET     /v1/images               requires-auth
GET     /v1/metrics              requires-auth
GET     /v1/status               requires-auth
POST    /v1/check                requires-auth
POST    /v1/update               requires-auth
